{
  "name": "toque-de-recolher",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Sobrevivência zumbi 2D top-down para Android (Phaser 4 + TypeScript).",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "pacote": "node scripts/pacote.mjs",
    "verificar": "npm run check && npm run test && npm run build"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
